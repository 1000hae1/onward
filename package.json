{
  "name": "onward",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run test && npm run build && wrangler deploy",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "e2e": "playwright test",
    "build:preview": "npm run typecheck && CLOUDFLARE_ENV=preview vite build --mode preview",
    "deploy:preview": "npm run test && npm run build:preview && wrangler deploy",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@playwright/test": "^1.65.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/three": "^0.187.0",
    "png-to-ico": "^3.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
