{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "onward",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-05",
  "assets": {
    // /api/* 와 /ws 만 Worker가 먼저 받고, 나머지는 정적 에셋으로 처리해요.
    "run_worker_first": ["/api/*", "/ws"],
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [{ "name": "WARD_ROOM", "class_name": "WardRoom" }]
  },
  "migrations": [
    // 무료 플랜에서 쓰려면 반드시 new_sqlite_classes 로 만들어야 해요.
    { "tag": "v1", "new_sqlite_classes": ["WardRoom"] }
  ]
}
