{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "onward",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-05",
  "assets": {
    // /api/*, /ws, /admin/* 만 Worker가 먼저 받고, 나머지는 정적 에셋으로 처리해요(/privacy 포함).
    "run_worker_first": ["/api/*", "/ws", "/admin", "/admin/*"],
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      { "name": "WARD_ROOM", "class_name": "WardRoom" },
      // 병동 전체가 함께 쓰는 하나뿐인 객체예요. 이름은 directory예요.
      { "name": "DIRECTORY", "class_name": "Directory" }
    ]
  },
  "migrations": [
    // 무료 플랜에서 쓰려면 반드시 new_sqlite_classes 로 만들어야 해요.
    { "tag": "v1", "new_sqlite_classes": ["WardRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["Directory"] }
  ]
}
